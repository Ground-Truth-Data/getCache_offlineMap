{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "import-tiler-dev",
	"main": "src/worker.ts",
	"compatibility_date": "2026-05-01",
	"containers": [
		{
			"class_name": "ImportTilerContainer",
			"image": "./Dockerfile",
			// ½ vCPU, 4 GiB: tippecanoe on a 64 MB GeoJSON; the 1 GB Fly plan risked running out.
			"instance_type": "standard-1",
			"max_instances": 2
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "IMPORT_TILER", "class_name": "ImportTilerContainer" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["ImportTilerContainer"] }],
	"observability": { "enabled": true }
}
