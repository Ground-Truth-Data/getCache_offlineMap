# Varlock schema for getCache_OfflineMap — every env var this child reads.
# SAFE TO COMMIT. Nothing here is a secret; this child never names the real
# tile hosts because it is open source and the worker URL is infrastructure.
#
# In the fetch workspace a parent serves this child and its .env supplies the
# values. Unset, the satellite layer still draws and no /pack request is ever
# sent — which looks like broken roads rather than missing configuration.
#
# @defaultSensitive=false @defaultRequired=false
# @auditIgnorePaths("_rapper", "_siblings", ".svelte-kit", "node_modules")
# ---

# Where /pack tile requests go. Run the tiles worker locally (`npm run dev`
# in lib/worker) and point this at it, or ask for the dev worker. Named after
# the Bitwarden secrets the parents resolve them from.
# @type=url
PUBLIC_GC_tiles_prod_worker=
# @type=url
PUBLIC_GC_tiles_dev_worker=

# Vite's own build-mode flag (import.meta.env.DEV); the environment never
# sets it. Declared so audit can match the reads.
# @type=string
DEV=
