# Every env var this repo reads. The Bitwarden block is generated; the rest is hand-kept knobs.
# rapper is copied into every public child: no infrastructure host as a literal here.
# WARNING: varlock reads decorators inside comments — no at-sign before a word in prose.
# @defaultSensitive=false @defaultRequired=false
# @auditIgnorePaths(".svelte-kit", "build", "node_modules")
# @import("~/.config/varlock/.env.retreever-local", allowMissing=true)
# @plugin(../node_modules/@varlock/bitwarden-plugin)
# @initBitwarden(accessToken=$BWS_ACCESS_TOKEN)
# ---

# @sensitive @internal @required
BWS_ACCESS_TOKEN=

# --- Bitwarden block: written from `bws secret list` by rapper/scripts/envFromBitwarden.mjs. Hand edits here are overwritten. ---
# --- end Bitwarden block ---

# --- Build knobs — set on the command line, never in .env ---------------------
# Vite's own build-mode flag (import.meta.env.DEV); the environment never
# sets it. Declared so audit can match the reads.
# @type=string
DEV=
# @type=string
BUILD_TARGET=

# --- Tier facts — pasted in by vite.config.ts `define`, never read from the
# environment. Declared only so audit can match the import.meta.env reads.
# @type=string
VITE_RAPPER_TIER=
# @type=string
VITE_OTHER_TIER=
# @type=url
VITE_OTHER_ORIGIN=
# @type=string
VITE_OTHER_HOME=
# @type=string
VITE_TIER_ROUTES=
# @type=string
VITE_TIER_SLOT=
# @type=string
VITE_MOUNTED_CHILD=
