# cp .env.example .env — then restart the dev server. Which variables you need
# depends on which child this rapper mounts; rapper itself needs none.

# VITE_TILES_HOST — getCache_OfflineMap. Where /pack tile requests go; unset,
# the map sends NO request and only the satellite layer draws (console warns).
# `npm create @retreever/rapper` writes rapper/.env with Ground Truth's public
# read-only hosts (tiles-prod.getcache.org, tiles-dev.getcache.org); this file
# is for a hand-cloned rapper, or for pointing at your own worker. The child
# itself bakes in no host, so a fork never inherits that bill.
VITE_TILES_HOST=https://<your-tiles-worker>
# With no Cloudflare account, run getCache_OfflineMap/worker (`npm run dev:local`)
# and use VITE_TILES_HOST=http://tiles-local.getcache.org:8787

# VITE_MAPBOX_TOKEN — getCache_OnlineMap, ReTreever_where. Boots Mapbox GL and
# the geocoder; unset, no map is created and the page names this variable.
# Free tokens: https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=
