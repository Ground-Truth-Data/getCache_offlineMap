# Package manager locks: COMMITTED, never ignored. A gitignored lockfile
# means clean installs (Vercel) float every ^-ranged dep to the newest
# version and silently drift from what builds locally. Keep them tracked.

# Data directory (Foundr-specific, harmless for others)
data/

