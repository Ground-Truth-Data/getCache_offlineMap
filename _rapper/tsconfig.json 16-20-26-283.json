// 19 Dec 2025 - Chris - DO NOT REMOVE "EXTENDS" LINE 1, it is required for aliasing.
{
	"extends": "./.svelte-kit/tsconfig.json",
	// NO "include"/"exclude" HERE ON PURPOSE. TypeScript REPLACES these keys, it
	// never merges them — the trailing comment in this file has always said so.
	// The override read ["src/**/*", ...], and rapper/src holds 3 .ts, 4 .css,
	// 1 .html and NO .svelte, so `npm run check` — the one verification command
	// this package advertises — reported:
	//     WARNING "No svelte input files were found in config file ..."
	//     COMPLETED 354 FILES 0 ERRORS   (exit 0)
	// It passed while examining zero Svelte files, in every scaffold anyone
	// installed. The generated config inherits the right set: the MOUNTED
	// CHILD's routes (../../<child>/routes/**/*.svelte), ../src, and ../tests.
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"module": "es2020",
		"noEmit": true,
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"lib": ["esnext", "DOM", "DOM.Iterable"]
	}
	// Path aliases are handled by https://kit.svelte.dev/docs/configuration#alias
	// except $lib which is handled by https://kit.svelte.dev/docs/configuration#files
	//
	// If you want to overwrite includes/excludes, make sure to copy over the relevant includes/excludes
	// from the referenced tsconfig.json - TypeScript does not merge them in
}
