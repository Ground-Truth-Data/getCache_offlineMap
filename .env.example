# Copy to `.env` and fill in. Vite reads it at boot.

# Where /pack tile requests go. Unset, the satellite layer still draws and no
# /pack request is ever sent — which looks like "the roads are broken" rather
# than like missing configuration.
#
# This child never names the real host: it is open source, and the worker URL
# is infrastructure. Ask for the dev worker, or run one locally with
# `npm run dev` in the tiles worker repo and point this at it.
VITE_TILES_HOST=https://<your-tiles-worker>
